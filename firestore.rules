rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /test/{docId} {
      allow read: if true;
    }

    match /clients/{clientId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(clientId);
      allow delete: if isSignedIn() && isValidId(clientId);
    }

    match /equipment/{equipmentId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(equipmentId);
      allow delete: if isSignedIn() && isValidId(equipmentId);
    }

    match /services/{serviceId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(serviceId);
      allow delete: if isSignedIn() && isValidId(serviceId);
    }

    match /appointments/{appointmentId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(appointmentId);
      allow delete: if isSignedIn() && isValidId(appointmentId);
    }
  }
}
